# 后端环境变量示例（复制为 .env 后按需修改；本文件会被提交，严禁填真实密钥）
# 数据库：本地用 SQLite；云端用 Postgres（可直接粘贴 Neon 的 postgresql:// 连接串，自动用 psycopg 驱动）
DATABASE_URL=sqlite:///./math_study.db
# 云端示例： DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# 鉴权：本机开发可设 false；云端/公网建议 true 并设置专属口令
AUTH_ENABLED=false
ACCESS_TOKEN=dev-secret-token

# CORS：允许的前端地址（逗号分隔）；同源托管(云端)时可不设置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 图片提取：配置 OpenAI 兼容「视觉/多模态」模型后，才能从图片自动提取核心思路/步骤
# 用 DeepSeek 视觉模型（推荐）：model 必须为 deepseek-v4-flash-vision-exp
# 真实密钥请只填入 .env（已 .gitignore）或将 Render 环境变量，勿写进本文件
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp
# 上传的题目图片存放目录（相对 backend 运行目录）
UPLOAD_DIR=uploads
# 前端构建产物目录（云端同源托管用；本地开发可不设置）
# FRONTEND_DIST=../frontend/dist
